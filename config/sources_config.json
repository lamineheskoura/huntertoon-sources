{
  "version": "2.2.1",
  "sources": {
    "azora": {
      "enabled": true,
      "requires_cf": true,
      "name": "أزورا مون (AzoraMoon)",
      "base_url": "https://azoramoon.com",
      "image_referer": "https://azoramoon.com/",
      "selectors": {
        "manga_title": "meta[property=\"og:title\"]",
        "manga_cover": "meta[property=\"og:image\"]",
        "manga_description": "meta[name=\"description\"]",
        "chapter_list": "a[href*=\"/chapter-\"]"
      },
      "other": {},
      "headers": {},
      "regex": {
        "slug": "/series/([^/?#]+)",
        "chapter_number": "/chapter-(\\d+(?:\\.\\d+)?)"
      }
    },
    "dilar": {
      "enabled": true,
      "requires_cf": true,
      "name": "ديلار (Dilar)",
      "base_url": "https://dilar.tube",
      "image_referer": "https://dilar.tube/",
      "selectors": {
        "api_list": "https://dilar.tube/api/series?page={page}&title={query}",
        "cover_url_pattern": "https://dilar.tube/uploads/manga/cover/{id}/large_{filename}",
        "api_details": "https://dilar.tube/api/series/{id}",
        "api_chapters": "https://dilar.tube/api/chapters/{id}",
        "page_url_pattern": "https://dilar.tube/uploads/releases/{storage_key}/hq/{filename}"
      },
      "other": {
        "icon_asset": "assets/icons/dilar.png"
      },
      "headers": {},
      "regex": {}
    },
    "hijala": {
      "enabled": true,
      "requires_cf": true,
      "name": "حجالة مانجا (Hijala)",
      "base_url": "https://hijala.com",
      "image_referer": "https://hijala.com/",
      "selectors": {
        "homepage_list": ".listupd .bs, .listupd .bsx",
        "homepage_cover": ".limit img, img",
        "homepage_title": ".tt a, .tt, img",
        "homepage_url": "a",
        "search_list": ".listupd .bs, .listupd .bsx",
        "search_cover": ".limit img, img",
        "search_title": ".tt a, .tt, img",
        "manga_title": ".entry-title, h1, meta[property=\"og:title\"]",
        "manga_cover": ".thumb img, meta[property=\"og:image\"]",
        "manga_description": ".entry-content p, .entry-content",
        "manga_genres": ".mgen a, .genres a",
        "chapter_list": "#chapterlist li, .eplister li, .clstyle li",
        "chapter_number_attr": "data-num",
        "chapter_date": ".chapterdate",
        "chapter_locked": ".fa-lock, .paywall",
        "chapter_reader_container": "#readerarea",
        "filter_list": ".listupd .bs",
        "filter_url": "a",
        "filter_cover": "img",
        "filter_title": ".tt a, .tt, img",
        "chapter_page_image": "#readerarea img"
      },
      "other": {
        "reader_fallback_strategy": "selector,noscript,regex,ts_reader",
        "chapter_image_extensions": ".webp,.jpg,.jpeg,.png",
        "chapter_ts_reader_pattern": "ts_reader\\.(?:run|init)\\s*\\(\\s*({[\\s\\S]*?})\\s*\\)"
      },
      "headers": {},
      "regex": {
        "chapter_image_regex": "<img[^>]+src\\s*=\\s*[\"']([^\"\']+)[\"']"
      }
    },
